# The repo is authored LF and CI runs on Linux. Without this, a Windows clone
# with core.autocrlf=true rewrites every file on checkout.
* text=auto eol=lf

# Except this one: cmd.exe wants CRLF.
*.bat text eol=crlf

# Git already detects these, but say it out loud so nobody "fixes" the rule above.
*.png binary
*.ico binary

# Generated by npm, 8k lines, never worth reading in a diff or a language stat.
package-lock.json -diff linguist-generated
